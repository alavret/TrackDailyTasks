# Список модулей для запуска в режиме --auto (через запятую)
# Доступные модули: license, delete_users
RUN_MODULES = license,delete_users

# OAuth токен для доступа к API Yandex 360
OAUTH_TOKEN = y0__

# ID организации в Yandex 360
ORG_ID = 1234567

# Путь к файлу с пользователями
USERS_FILE = users.csv

# Параметры для отслеживания лицензий
LICENSES_COUNT = 1000
LICENSES_THRESHOLD = 10

# Параметры для удаления пользователей
# Количество дней после блокировки пользователя для удаления
DELETE_AFTER_LOCKED_DAYS = 90
# Количество дней после блокировки пользователя для выдачи предупреждения об будущем удалении
WARNING_DAYS = 10
# Удалять пользователей
DELETE_USERS = True
# Значение для пустой даты (если поле isEnabledAt пустое)
VALUE_FOR_EMPTY_DATE = 2025-01-01
# Количество дней назад для проверки IMAP почты писем с запросом на удаление пользователя
CHECK_IMAP_DAYS = 7
# Тема сообщения для подтверждения удаления
CONFIRM_MESSAGE_SUBJECT = Подтверждение удаления пользователей
# Тема сообщения для отправки уведомлений о лицензиях
LICENSE_WARNING_MESSAGE_SUBJECT = [Yandex 360] Отчёт о лицензиях
# Тема сообщения ожидания подтверждения удаления
WAITING_CONFIRMATION_SUBJECT = [Yandex 360] Ожидание подтверждения

# Режим пробного запуска (true/false)
DRY_RUN = False

# Параметры IMAP для подтверждения удаления
IMAP_SERVER = imap.yandex.ru
IMAP_PORT = 993
IMAP_LOGIN = deleteion_agent@domain.ru
IMAP_PASSWORD = password
# Дополнительная папка для поиска писем подтверждения (опционально, может быть на русском)
CONFIRMATION_IMAP_FOLDER = Яндекс360

# Параметры SMTP для отправки уведомлений (может быть таким же как и для IMAP)
SMTP_SERVER = smtp.yandex.ru
SMTP_PORT = 465
SMTP_LOGIN = notifier@domain.ru
SMTP_PASSWORD = password
SMTP_FROM_EMAIL = notifier@domain.ru
SMTP_TYPE = ssl

# Email для отправки уведомлений
ALERT_EMAIL = it-support@domain.ru
# Список email адресов одобренных отправителей для подтверждения удаления (через запятую)
APPROVED_SENDERS = admin@domain.ru, it-support@domain.ru

